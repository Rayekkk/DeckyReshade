{
  "name": "deckyreshade",
  "version": "1.0.0",
  "description": "DeckyLoader plugin: ReShade for Steam and non-Steam games under Proton, set up and kept up to date from Gaming Mode",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "rollup -c && node scripts/check-build.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "test:backend": "python -W error -m unittest discover -s tests -p \"test_*.py\"",
    "test:frontend": "node --test \"tests/*.test.cjs\"",
    "check": "npm run typecheck && npm run test:backend && npm run test:frontend && npm run build && npm run package"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.1.1",
    "rollup": "^4.0.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "decky": {
    "files": [
      "main.py",
      "reshade_*.py",
      "dk_*.py",
      "plugin.json",
      "package.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "NOTICE",
      "dist"
    ],
    "forbidden": [
      "\\.(dll|exe|so|pdb)$",
      "d3dcompiler",
      "\\.addon(32|64)?$"
    ],
    "folder": "DeckyReshade",
    "python": ["3.14"],
    "flags": []
  }
}
